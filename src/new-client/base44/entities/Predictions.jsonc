{
  "name": "Prediction",
  "type": "object",
  "properties": {
    "disease_name": {
      "type": "string",
      "description": "Detected disease name or 'Healthy'"
    },
    "crop_type": {
      "type": "string",
      "enum": [
        "maize",
        "potato",
        "bean",
        "other"
      ],
      "description": "Identified crop type"
    },
    "confidence": {
      "type": "number",
      "description": "Confidence score 0-1"
    },
    "severity": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "moderate",
        "high",
        "severe"
      ]
    },
    "description": {
      "type": "string",
      "description": "Short description of the condition"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the analyzed leaf image"
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "treatment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prevention": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "disease_name",
    "crop_type",
    "confidence",
    "severity",
    "image_url"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}